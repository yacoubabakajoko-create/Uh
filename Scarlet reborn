local tpAccum = 0
Bind(RunService.Heartbeat:Connect(function(dt)
    if not autoPlayActive or not me.Character then return end
    local ball = getBall()
    local root = me.Character:FindFirstChild("HumanoidRootPart")
    local hum = me.Character:FindFirstChildOfClass("Humanoid")
    if not ball or not root or not hum then return end
    
    -- 1. Move to ball if far away
    local dist = (ball.Position - root.Position).Magnitude
    if dist > 6 then
        hum:MoveTo(ball.Position)
    else
        -- 2. Auto Kick if close
        tpAccum += dt
        if tpAccum > 0.1 then
            tpAccum = 0
            -- Use the Aimbot to kick towards the goal
            if aimbotConfig.enabled then
                -- Let the Aimbot hooks handle it naturally
            else
                -- Force a basic kick if aimbot is off
                local kickVel = Vector3.new(0, 30, 0)
                local goalCenter = goalLocations[aimbotConfig.goal]
                local dir = (goalCenter - ball.Position).Unit
                kickVel = (dir * 80) + Vector3.new(0, 20, 0)
                pcall(function()
                    KickBallRemote:FireServer(ball.Position, kickVel, Vector3.new(0,0,0), dist, ValidKickKey)
                end)
            end
        end
    end
end))

