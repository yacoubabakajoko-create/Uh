    btn.Size=UDim2.new(0,120,0,36) 
    btn.Position=UDim2.new(0.8,-20,0.15,yOffset) 
    btn.BackgroundColor3=FloatingButtonTheme.Background 
    btn.BackgroundTransparency=0.15 
    btn.TextColor3=FloatingButtonTheme.Text 
    btn.Font=Enum.Font.GothamMedium 
    btn.TextSize=13 
    btn.Visible=false 
    btn.AutoButtonColor=false 
    btn.Parent=ScreenGuiToggles 
    table.insert(ScreenWidgets,btn) 
    
    local corner=Instance.new("UICorner") 
    corner.CornerRadius=UDim.new(0,8) 
    corner.Parent=btn 
    
    local stroke=Instance.new("UIStroke") 
    stroke.Color=FloatingButtonTheme.Outline 
    stroke.Thickness=1.2 
    stroke.Parent=btn 
    
    local function UpdateVisuals(isOn) 
        if isOn then 
            btn.BackgroundColor3=FloatingButtonTheme.Accent 
            btn.TextColor3=Color3.fromRGB(255,255,255) 
            stroke.Color=Color3.fromRGB(255,255,255) 
            if not isAction then btn.Text=name.." [ON]" end 
        else 
            btn.BackgroundColor3=FloatingButtonTheme.Background 
            btn.TextColor3=FloatingButtonTheme.Text 
            stroke.Color=FloatingButtonTheme.Outline 
            if not isAction then btn.Text=name.." [OFF]" end 
        end 
    end 
    
    local dragging=false 
    local dragStart=nil 
    local startPos=nil 
    local hasMoved=false 
    
    Bind(btn.InputBegan:Connect(function(input) 
        if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then 
            hasMoved=false 
            if not buttonsLocked then 
                dragging=true 
                dragStart=input.Position 
                startPos=btn.Position 
            end 
        end 
    end)) 
    
    Bind(btn.InputEnded:Connect(function(input) 
        if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then 
            if dragging then 
                dragging=false 
                SaveWidgetPositions() 
            end 
        end 
    end)) 
    
    Bind(UserInputService.InputChanged:Connect(function(input) 
        if dragging and not buttonsLocked and (input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseMovement) then 
            local delta=input.Position-dragStart 
            if delta.Magnitude>5 then 
                hasMoved=true 
                btn.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y) 
            end 
        end 
    end)) 
    
    Bind(btn.MouseButton1Click:Connect(function() 
        if not hasMoved then 
            if isAction then 
                activeVarFunc() 
                btn.BackgroundColor3=FloatingButtonTheme.Accent 
                task.delay(0.3,function() 
                    btn.BackgroundColor3=FloatingButtonTheme.Background 
                end) 
            elseif Elements[targetToggleId] then 
                Elements[targetToggleId]:Set(not activeVarFunc()) 
            end 
        end 
    end)) 
    
    if not isAction then 
        local lastState=nil 
        Bind(RunService.Heartbeat:Connect(function() 
            local currentState=activeVarFunc() 
            if currentState~=lastState then 
                lastState=currentState 
                UpdateVisuals(currentState) 
            end 
        end)) 
    end 
    
    return btn 
end

