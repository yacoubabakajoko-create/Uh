    local saveReact = math.clamp(S.GK_SAVE_REACT or 1.7, 0.5, 3.0)
    local isActivelySaving = inEmergencyReach or (isShotOnTarget and timeToGoal<=saveReact*1.05)
    if not isActivelySaving then lv.Enabled=false; ao.Enabled=false; smoothVelocity=Vector3.zero; return end
    local st = hum:GetState()
    local onGround = st~=Enum.HumanoidStateType.Jumping and st~=Enum.HumanoidStateType.Freefall
    local jumpReact = math.clamp(S.GK_JUMP_REACT or 0.4, 0.1, 1.0)
    if onGround and predY>=STAND_REACH_Y and timeToGoal<=jumpReact then hum.Jump=true; hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    lv.Enabled=true; ao.Enabled=true; lv.MaxAxesForce=Vector3.new(500000,0,500000)
    local lungeVec = Vector3.new(targetX,hrp.Position.Y,targetZ)-hrp.Position
    local desiredVel = Vector3.zero
    if lungeVec.Magnitude>0.05 then
        desiredVel = lungeVec*40
        local diveLimit = math.clamp(S.GK_DIVE_SPEED or 26, 10, 60)
        if desiredVel.Magnitude>diveLimit then desiredVel=desiredVel.Unit*diveLimit end
    end
    local softSpeed = 8
    if inEmergencyReach then
        if flatDistToBall<=1.6 then desiredVel=Vector3.zero
        else local cap=6; if desiredVel.Magnitude>cap then desiredVel=desiredVel.Unit*cap end end
    else
        local softRange=reachVal+1.0; local brakeRange=reachVal+3.5
        if flatDistToBall<=softRange then if desiredVel.Magnitude>softSpeed then desiredVel=desiredVel.Unit*softSpeed end
        elseif flatDistToBall<=brakeRange then local cap=math.max(softSpeed*2,10); if desiredVel.Magnitude>cap then desiredVel=desiredVel.Unit*cap end end
    end
    smoothVelocity = smoothVelocity + (desiredVel-smoothVelocity)*1.0
    lv.VectorVelocity = smoothVelocity
    local lookDir = Vector3.new(ballPos.X,hrp.Position.Y,ballPos.Z)-hrp.Position
    if lookDir.Magnitude>0.1 then ao.CFrame=CFrame.lookAt(hrp.Position, hrp.Position+lookDir.Unit*10) end
end)))

