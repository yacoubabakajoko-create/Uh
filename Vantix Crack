local function createTrainerGoal()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local hrp = char.HumanoidRootPart
    if workspace:FindFirstChild("CustomGoalPart") then workspace.CustomGoalPart:Destroy() end
    local p = Instance.new("Part")
    p.Name = "CustomGoalPart"
    p.Size = Vector3.new(6, 1, 6)
    p.Position = hrp.Position + Vector3.new(0, 0.5, 0)
    p.Anchored = true
    p.CanCollide = false
    p.BrickColor = BrickColor.new("Bright blue")
    p.Transparency = 0.4
    p.Material = Enum.Material.Neon
    p.Parent = workspace
    GoalTrainer.goalPart = p
    return true
end
local function trainerTeleportBall()
    local gp = GoalTrainer.goalPart
    if not gp or not gp.Parent then return end
    local char = player.Character; if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart"); if not root then return end
    local ball = findBallNow()
    if ball then
        local newPos = root.Position + (root.CFrame.LookVector * 4)
        ball.CFrame = CFrame.new(newPos)
        ball.Velocity = Vector3.new(0, 5, 0)
    end
end
local function trainerTeleportPlayer()
    local gp = GoalTrainer.goalPart
    if not gp or not gp.Parent then return end
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    char.HumanoidRootPart.CFrame = gp.CFrame * CFrame.new(0, 3, 0)
end
local function startGoalTrainer()
    if GoalTrainer.running then return false, "Already running" end
    if not GoalTrainer.goalPart or not GoalTrainer.goalPart.Parent then return false, "Create goal first!" end
    GoalTrainer.running = true
    GoalTrainer.loopThread = task.spawn(function()
        while GoalTrainer.running do
            pcall(trainerTeleportPlayer)
            task.wait(0.2)
            pcall(trainerTeleportBall)
            task.wait(0.8)
        end
    end)
    return true
end
local function stopGoalTrainer()
    GoalTrainer.running = false
    if GoalTrainer.loopThread then
        pcall(task.cancel, GoalTrainer.loopThread)
        GoalTrainer.loopThread = nil
    end
end

