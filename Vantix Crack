task.spawn(function()
    task.wait(2)
    local gc, isL, hookF = getgc or get_gc, islclosure or is_l_closure, hookfunction or hookfunc
    if not (gc and isL and hookF) then return end
    local info = debug and debug.getinfo; if not info then return end
    local function tryHookTouch(v)
        local orig
        local ok = pcall(function()
            orig = hookF(v, nc(CTN_NO_VIRTUALIZE(function(...)
                pcall(reachRefreshTorso)
                if isAnyReachFeatureOn() and ReachSystem.UNTACKLABLE and reachWithinDenyRange() then
                    local n = select("#", ...)
                    for idx = 1, n do if reachIsOtherPlayerPart((select(idx, ...))) then return nil end end
                end
                if not orig then return nil end
                local ok2, ret = pcall(orig, ...); if ok2 then return ret end
            end)))
        end)
        return ok and orig
    end
    local function tryHookClosest(v)
        local orig
        local ok = pcall(function()
            orig = hookF(v, nc(CTN_NO_VIRTUALIZE(function(...)
                if isAnyReachFeatureOn() and reachBallAlive() then return player.Name end
                if orig then return orig(...) end
            end)))
        end)
        return ok and orig
    end
    local function tryHookPriority(v)
        local orig
        local ok = pcall(function()
            orig = hookF(v, nc(CTN_NO_VIRTUALIZE(function(...)
                if orig then pcall(orig, ...) end
                if isAnyReachFeatureOn() and reachBallAlive() then return ReachSystem.PRIORITY end
                return 0
            end)))
        end)
        return ok and orig
    end
    local function install()
        local needT, needC, needP = not ReachSystem.hookedTouch, not ReachSystem.hookedClosest, not ReachSystem.hookedPriority
        if not (needT or needC or needP) then return true end
        local snap; pcall(function() snap = gc() end); if not snap then return false end
        for _, v in pairs(snap) do
            if not (needT or needC or needP) then break end
            if type(v) == "function" and isL(v) then
                local ok, i = pcall(info, v)
                if ok and i then
                    local name = i.name
                    if needT and name == "touchDetect" then
                        if tryHookTouch(v) then ReachSystem.hookedTouch = v; needT = false end
                    elseif needC and name == "getClosestPlayerName" then
                        if tryHookClosest(v) then ReachSystem.hookedClosest = v; needC = false end
                    elseif needP and (name == "getPriority" or name == "calculatePriority" or name == "getPlayerPriority" or name == "getBallPriority" or name == "getPriorityValue" or name == "computePriority" or name == "getTouchPriority") then
                        if tryHookPriority(v) then ReachSystem.hookedPriority = v; needP = false end
                    end
                end
            end
        end
        return (not (needT or needC or needP))
    end
    for _ = 1, 10 do
        local done = pcall(install)
        if done and ReachSystem.hookedTouch and ReachSystem.hookedClosest and ReachSystem.hookedPriority then break end
        task.wait(0.8)
    end
end)

