        targetPos = goalLocations[aimbotConfig.goal] + Vector3.new(0, math.random(-1, 6), math.random(-12, 12))
        offsetHeight = targetPos.Y - goalLocations[aimbotConfig.goal].Y
    elseif aimbotConfig.furthestCorner then
        local baseGoalPos = goalLocations[aimbotConfig.goal]
        local topRightPos = baseGoalPos + getOffsetForGoal("TopRight", aimbotConfig.goal)
        local topLeftPos = baseGoalPos + getOffsetForGoal("TopLeft", aimbotConfig.goal)
        if (topRightPos - startPosition).Magnitude > (topLeftPos - startPosition).Magnitude then targetPos = topRightPos else targetPos = topLeftPos end
        offsetHeight = targetOffsets["TopRight"].Y; isCorner = true
    else
        local selectedOffset = getOffsetForGoal(aimbotConfig.corner, aimbotConfig.goal)
        targetPos = goalLocations[aimbotConfig.goal] + selectedOffset
        offsetHeight = selectedOffset.Y; isCorner = (aimbotConfig.corner ~= "Center")
    end
    local goalCenter = goalLocations[aimbotConfig.goal]
    local distToGoal = (goalCenter - startPosition).Magnitude
    local myZ, goalZ = startPosition.Z, goalCenter.Z
    local targetHeight = aimbotConfig.topCornerMode and ((distToGoal>120) and 0.5 or 1.5) or ((distToGoal>150) and -3.5 or (distToGoal>120) and -2.0 or (distToGoal>80) and -0.5 or 0.5)
    local finalY
    if aimbotConfig.topCornerMode then finalY = AB_SAFE_Y_MAX - 0.3
    elseif isCorner then finalY = goalCenter.Y + offsetHeight
    else finalY = goalCenter.Y + targetHeight + offsetHeight end
    finalY = math.clamp(finalY, AB_SAFE_Y_MIN, AB_SAFE_Y_MAX - 0.3)
    targetPos = Vector3.new(targetPos.X, finalY, targetPos.Z)
