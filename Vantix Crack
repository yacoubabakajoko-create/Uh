local cachedGoalParts, lastAimbotBall = {}, nil
local detectEnemyGoal = CTN_JIT(function()
    local myColor = nil
    if player.Team then myColor = player.TeamColor end
    if not myColor and player.Character then
        local torso = player.Character:FindFirstChild("Torso") or player.Character:FindFirstChild("UpperTorso")
        if torso and torso:IsA("BasePart") then myColor = torso.BrickColor end
    end
    if not myColor then return aimbotConfig.goal end
    local ball = getBall(); if not ball then return aimbotConfig.goal end
    if ball ~= lastAimbotBall then cachedGoalParts = {}; lastAimbotBall = ball end
    if #cachedGoalParts == 0 then
        local searchArea = Workspace:FindFirstChild("FootballField") and Workspace.FootballField:GetDescendants() or Workspace:GetDescendants()
        for _, part in ipairs(searchArea) do
            if part:IsA("BasePart") and part.Transparency < 1 then
                local name = part.Name:lower()
                local parentName = part.Parent and part.Parent.Name:lower() or ""
                if name:find("goal") or name:find("post") or parentName:find("goal") then
                    if part.BrickColor.Name ~= "Institutional white" and part.BrickColor.Name ~= "White" and part.BrickColor.Name ~= "Medium stone grey" then
                        table.insert(cachedGoalParts, part)
                    end
                end
            end
        end
    end
    local colorA, colorB = nil, nil
    local distA_min, distB_min = 40, 40
    for _, part in ipairs(cachedGoalParts) do
        if part and part.Parent then
            local distA = (part.Position - goalLocations.A).Magnitude
            local distB = (part.Position - goalLocations.B).Magnitude
            if distA < distA_min then distA_min = distA; colorA = part.BrickColor
            elseif distB < distB_min then distB_min = distB; colorB = part.BrickColor end
        else cachedGoalParts = {}; return aimbotConfig.goal end
    end
    if colorA and colorA == myColor then return "B" end
    if colorB and colorB == myColor then return "A" end
    if colorA and colorA ~= myColor then return "A" end
    if colorB and colorB ~= myColor then return "B" end
    return aimbotConfig.goal
end)
