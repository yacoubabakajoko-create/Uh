    local function copyTable(t)
        local out = {}
        for k, v in pairs(t) do
            if type(v) == "table" then out[k] = copyTable(v)
            else out[k] = v end
        end
        return out
    end

    local function listSavedConfigs()
        local names = {}
        if isfolder and isfolder(CONFIG_FOLDER) then
            local ok, files = pcall(listfiles, CONFIG_FOLDER)
            if ok and files then
                for _, f in ipairs(files) do
                    local n = tostring(f):match("([^/\\]+)%.json$")
                    if n and n ~= "_autoload" then table.insert(names, n) end
                end
                table.sort(names)
            end
        end
        return names
    end

    local saveCurrentConfig = function(name)
        if not writefile then return false, "no filesystem" end
        local widgetData = {}
        for id, w in pairs(widgetRefs) do
            if w and w.button then
                widgetData[id] = {
                    visible = w.button.Visible,
                    x = w.button.Position.X.Offset,
                    y = w.button.Position.Y.Offset,
                    active = w.isActive and w.isActive() or false,
                }
            end
        end
        local keybindData = {}
        for id, b in pairs(KEYBINDS) do
            if b and b.keyCode then keybindData[id] = b.keyCode.Name end
        end
        local data = {
            S = copyTable(S),
            AP = copyTable(AP),
            V = copyTable(V),
            GLOVE = copyTable(GLOVE),
            RC = copyTable(RC),
            BallTimeConfig = copyTable(BallTimeCfg),
            AUTO_GOAL = {enabled = AUTO_GOAL.enabled, mode = AUTO_GOAL.mode},
            aimbotConfig = copyTable(aimbotConfig),
            AutoJuggleV1 = copyTable(getgenv().AutoJuggleV1),
            BallPredictor = {enabled = BPcfg.enabled},
            ReachSystem = {REACH = ReachSystem.REACH, BALL_SPEED = ReachSystem.BALL_SPEED},
            ESP_CONFIG = copyTable(ESP_CONFIG),
            TRAIL_CONFIG = copyTable(TRAIL_CONFIG),
            WIDGET_SCALE = WIDGET_SCALE,
            WidgetData = widgetData,
            Keybinds = keybindData,
            AB_PRECISE_DOTS = AB_PRECISE_DOTS,
        }
        local ok, err = pcall(function()
            writefile(CONFIG_FOLDER .. "/" .. name .. ".json", HttpService:JSONEncode(data))
        end)
        return ok, err
    end

    local loadConfigFile = function(name)
        if not isfile then return false end
        local path = CONFIG_FOLDER .. "/" .. name .. ".json"
        if not isfile(path) then return false end
        local ok, raw = pcall(readfile, path); if not ok or not raw then return false end
        local data; pcall(function() data = HttpService:JSONDecode(raw) end)
        if not data then return false end
        if data.S then for k, v in pairs(data.S) do if S[k] ~= nil then S[k] = v end end end
        if data.AP then for k, v in pairs(data.AP) do if AP[k] ~= nil then AP[k] = v end end end
        if data.V then for k, v in pairs(data.V) do if V[k] ~= nil then V[k] = v end end end
        if data.GLOVE then
            for k, v in pairs(data.GLOVE) do
                if k == "colors" and type(v) == "table" then
                    for kk, vv in pairs(v) do if GLOVE.colors[kk] then GLOVE.colors[kk] = vv end end
                elseif GLOVE[k] ~= nil then GLOVE[k] = v end
            end
        end
        if data.RC then for k, v in pairs(data.RC) do if RC[k] ~= nil then RC[k] = v end end end
        if data.BallTimeConfig then for k, v in pairs(data.BallTimeConfig) do if BallTimeCfg[k] ~= nil then BallTimeCfg[k] = v end end end
        if data.AUTO_GOAL then
            for k, v in pairs(data.AUTO_GOAL) do if AUTO_GOAL[k] ~= nil then AUTO_GOAL[k] = v end end
            AUTO_GOAL.lastFire = 0
        end
        if data.aimbotConfig then for k, v in pairs(data.aimbotConfig) do if aimbotConfig[k] ~= nil then aimbotConfig[k] = v end end end
        if data.AutoJuggleV1 then for k, v in pairs(data.AutoJuggleV1) do if getgenv().AutoJuggleV1[k] ~= nil then getgenv().AutoJuggleV1[k] = v end end end
        if data.ReachSystem then
            if data.ReachSystem.REACH then ReachSystem.REACH = data.ReachSystem.REACH end
            if data.ReachSystem.BALL_SPEED then ReachSystem.BALL_SPEED = data.ReachSystem.BALL_SPEED end
        end
        if data.BallPredictor and type(data.BallPredictor) == "table" then
            BPcfg.enabled = data.BallPredictor.enabled == true
        end
        if data.ESP_CONFIG then for k, v in pairs(data.ESP_CONFIG) do if ESP_CONFIG[k] ~= nil then ESP_CONFIG[k] = v end end end
        if data.TRAIL_CONFIG then for k, v in pairs(data.TRAIL_CONFIG) do if TRAIL_CONFIG[k] ~= nil then TRAIL_CONFIG[k] = v end end end
        if type(data.WIDGET_SCALE) == "number" then refreshAllWidgetScales(data.WIDGET_SCALE) end
        rankBypassCfg.enabled = V.rankBypassEnabled
        if data.AB_PRECISE_DOTS and type(data.AB_PRECISE_DOTS) == "table" then
            for i = #AB_PRECISE_DOTS, 1, -1 do table.remove(AB_PRECISE_DOTS, i) end
            for _, d in ipairs(data.AB_PRECISE_DOTS) do
                if type(d) == "table" and type(d.x) == "number" and type(d.y) == "number" then
                    table.insert(AB_PRECISE_DOTS, {x = d.x, y = d.y})
                end
            end
            if popupRefs.aim and popupRefs.aim.renderDots then pcall(popupRefs.aim.renderDots) end
        end
        if data.WidgetData then
            for id, wd in pairs(data.WidgetData) do
                local w = widgetRefs[id]
                if w and w.button then
                    pcall(function()
                        if type(wd.x) == "number" and type(wd.y) == "number" then
                            w.button.Position = UDim2.new(0, wd.x, 0, wd.y)
                        end
                        if wd.visible ~= nil then w.setVisible(wd.visible == true) end
                        if wd.active ~= nil then w.setActive(wd.active == true) end
                    end)
                end
            end
        end
        if data.Keybinds then
            for id, kname in pairs(data.Keybinds) do
                local kc = Enum.KeyCode[kname]
                if kc then KEYBINDS[id] = {inputType = Enum.UserInputType.Keyboard, keyCode = kc} end
            end
        end
