local calculateShot = CTN_JIT(function(startPosition)
    local targetPos, offsetHeight, isCorner = nil, 0, false
    if aimbotConfig.randomAim then
        targetPos = goalLocations[aimbotConfig.goal] + Vector3.new(0, math.random(-1, 6), math.random(-12, 12))
        offsetHeight = targetPos.Y - goalLocations[aimbotConfig.goal].Y
    elseif aimbotConfig.furthestCorner then
        local baseGoalPos = goalLocations[aimbotConfig.goal]
        local topRightPos = baseGoalPos + getOffsetForGoal("TopRight", aimbotConfig.goal)
        local topLeftPos = baseGoalPos + getOffsetForGoal("TopLeft", aimbotConfig.goal)
        if (topRightPos - startPosition).Magnitude > (topLeftPos - startPosition).Magnitude then targetPos = topRightPos else targetPos = topLeftPos end
        offsetHeight = targetOffsets["TopRight"].Y; isCorner = true
    else
        local selectedOffset = getOffsetForGoal(aimbotConfig.corner, aimbotConfig.goal)
        targetPos = goalLocations[aimbotConfig.goal] + selectedOffset
        offsetHeight = selectedOffset.Y; isCorner = (aimbotConfig.corner ~= "Center")
    end
    local distToGoal = (goalLocations[aimbotConfig.goal] - startPosition).Magnitude
    local matchedHeight = (distToGoal>150) and -1.5 or (distToGoal>120) and 0.5 or (distToGoal>80) and 2.5 or (distToGoal>50) and 3.5 or (distToGoal>30) and 1.5 or (distToGoal>15) and -2.5 or -4.0
    local finalY
    if aimbotConfig.topCornerMode then finalY = AB_SAFE_Y_MAX - 0.3
    elseif isCorner then finalY = goalLocations[aimbotConfig.goal].Y + offsetHeight
    else finalY = goalLocations[aimbotConfig.goal].Y + matchedHeight + offsetHeight end
    finalY = math.clamp(finalY, AB_SAFE_Y_MIN, AB_SAFE_Y_MAX - 0.3)
    targetPos = Vector3.new(targetPos.X, finalY, targetPos.Z)
    local displacement = targetPos - startPosition
    local flatDist = Vector3.new(displacement.X, 0, displacement.Z).Magnitude
    local power = aimbotConfig.maxPower
    if distToGoal>150 then power=power*1.25 elseif distToGoal>120 then power=power*1.15 elseif distToGoal>80 then power=power*1.05 elseif distToGoal>30 then power=power*0.85 else power=power*0.7 end
    local horizontalSpeed = power*0.95
    local airTime = math.max(flatDist/horizontalSpeed, 0.05)
    local velY = (displacement.Y + (0.5*aimbotConfig.gravity*(airTime^2)))/airTime
    local v = Vector3.new(displacement.X/airTime, velY, displacement.Z/airTime)
    if v.Magnitude > power then v = v.Unit*power end
    return v
end)

local calculateExactShot = CTN_JIT(function(startPosition, originalVelocity)
    local targetPos, offsetHeight, isCorner = nil, 0, false
