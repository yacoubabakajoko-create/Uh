            if n:find("ball") or n:find("soccer") or n:find("football") then if not v.Anchored and v.Transparency < 1 then return v end end
        end
    end
    return nil
end)

local ballControlTick = CTN_JIT(function()
    if not (BALL_CTL.freeze or AUTO_GOAL.enabled) then return end
    local b = findBallNow(); if not b then return end

    if BALL_CTL.freeze then
        if not BALL_CTL.frozenCFrame then
            BALL_CTL.frozenCFrame = b.CFrame
            BALL_CTL.frozenAnchored = b.Anchored
        end
        pcall(function()
            if not BALL_CTL._ownedNet and b.SetNetworkOwner and not b.Anchored then
                local okOwner = pcall(function() b:SetNetworkOwner(player) end)
                if okOwner then BALL_CTL._ownedNet = true end
            end
            b.Anchored = true
            b.CanCollide = false
            b.AssemblyLinearVelocity = Vector3.zero
            b.AssemblyAngularVelocity = Vector3.zero
            b.CFrame = BALL_CTL.frozenCFrame
        end)
    end

    if AUTO_GOAL.enabled and not BALL_CTL.freeze then
        local now = os.clock()
        if (now - AUTO_GOAL.lastFire) > 1.0 then
            local myGoalKey = getMyGoal()
            local goalKey = myGoalKey and ((myGoalKey == "A") and "B" or "A") or "B"
            local target = goalLocations[goalKey]
            local scoreSign = (goalKey == "B") and 1 or -1
            local distToGoal = (b.Position - target).Magnitude
            pcall(function()
                if distToGoal > 30 then b.CFrame = CFrame.new(target.X - scoreSign * 10, target.Y + 2, target.Z) end
                b.AssemblyLinearVelocity = Vector3.new(scoreSign * 60, 10, 0)
            end)
            AUTO_GOAL.lastFire = now
            if AUTO_GOAL.mode == "SINGLE" then
                AUTO_GOAL.enabled = false
                if AUTO_GOAL._refreshToggle then pcall(AUTO_GOAL._refreshToggle, false) end
            end
        end
    end
end)
Bind(RunService.Stepped:Connect(CTN_NO_VIRTUALIZE(function() ballControlTick() end)))
Bind(RunService.RenderStepped:Connect(CTN_NO_VIRTUALIZE(function() ballControlTick() end)))
Bind(RunService.Heartbeat:Connect(CTN_NO_VIRTUALIZE(function() ballControlTick() end)))

